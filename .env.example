# Copy this file to .env and fill in the values. Never commit .env.
# On Streamlit Community Cloud, put the same names in the app's Secrets settings instead.

# Groq API key (Whisper transcription and the LLM): https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API key (embeddings for Q&A): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Hosted demo only: passwords for the admin, alice and bob users, created on first start
# when the database is empty. Use long random values, different from the local demo
# passwords in seed_users.py. Leave empty for local use (run seed_users.py instead).
DEMO_PASSWORD_ADMIN=

DEMO_PASSWORD_ALICE=

DEMO_PASSWORD_BOB=
